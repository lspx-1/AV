<Page
    x:Class="Bastion.App.Views.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Bastion.App.ViewModels"
    Title="Quarantäne">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="40,8,40,40">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Quarantäne" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Gefundene Dateien liegen hier verschlüsselt und können nichts mehr anrichten." />
                </StackPanel>
                <ui:Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding DeleteAllCommand}"
                    Content="Alle löschen"
                    Icon="{ui:SymbolIcon Delete24}"
                    Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}" />
            </Grid>

            <Border Padding="32" Style="{StaticResource GlassPanel}" Visibility="{Binding Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{StaticResource OkBrush}" Symbol="ShieldCheckmark24" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Die Quarantäne ist leer" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource RowDetail}" Text="Wenn Bastion etwas findet, landet es hier." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassPanel}" Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuarantineItemViewModel}">
                            <Border x:Name="Row" Padding="16,12" Style="{StaticResource RowDivider}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,2,14,0" VerticalAlignment="Top" FontSize="20" Foreground="{StaticResource BadBrush}" Symbol="LockClosed24" />
                                    <StackPanel Grid.Column="1" ToolTip="{Binding Reason}">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding FileName}" />
                                        <TextBlock Style="{StaticResource RowDetail}" Text="{Binding Detection}" Foreground="{StaticResource BadBrush}" />
                                        <TextBlock Style="{StaticResource MonoDetail}" Text="{Binding OriginalPath}" />
                                        <TextBlock Style="{StaticResource RowDetail}" Text="{Binding Meta}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:Button Margin="0,0,8,0" Command="{Binding RestoreCommand}" Content="Wiederherstellen" Icon="{ui:SymbolIcon ArrowUndo24}" />
                                        <ui:Button Command="{Binding DeleteCommand}" Content="Löschen" Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
