<Page
    x:Class="Bastion.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Einstellungen">

    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource RowDivider}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="40,8,40,90">
                <TextBlock Style="{StaticResource PageTitle}" Text="Einstellungen" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding ModeText}" />

                <!--  Appearance  -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="DARSTELLUNG" />
                <Border Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Farbschema" />
                            <ComboBox MinWidth="180" HorizontalAlignment="Right" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" />
                        </Grid>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Hintergrund" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Glas lässt den Desktop durchscheinen (Windows 11)." />
                                </StackPanel>
                                <ComboBox MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding Backdrops}" SelectedIndex="{Binding BackdropIndex}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Glas-Tönung" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Links durchsichtiger, rechts kräftiger und besser lesbar." />
                                </StackPanel>
                                <Slider
                                    Width="200"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="5"
                                    Value="{Binding GlassTint, Delay=150}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Benachrichtigungen bei Funden anzeigen" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowNotifications}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Beim Schließen in den Infobereich minimieren" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Windows  -->
                <TextBlock Margin="4,24,0,8" Style="{StaticResource SectionHeader}" Text="WINDOWS" />
                <Border Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Mit Windows starten" />
                            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="„Mit Bastion scannen“ im Explorer" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Rechtsklick auf Dateien und Ordner." />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ExplorerContextMenu}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Bastion-Dienst" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ServiceState}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Protection  -->
                <TextBlock Margin="4,24,0,8" Style="{StaticResource SectionHeader}" Text="SCHUTZ" />
                <Border Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <Grid Margin="16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Empfindlichkeit der Heuristik" />
                                <TextBlock Style="{StaticResource RowDetail}" Text="Hoch findet mehr Unbekanntes, meldet aber auch öfter harmlose Programme." />
                            </StackPanel>
                            <ComboBox MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding Sensitivities}" SelectedIndex="{Binding SensitivityIndex}" />
                        </Grid>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Zusammenarbeit mit anderem Virenschutz" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Neben Bitdefender, ESET usw. scannt Bastion Dokumente nicht doppelt." />
                                </StackPanel>
                                <ComboBox MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding ComplementaryModes}" SelectedIndex="{Binding ComplementaryIndex}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Bekannte Schadsoftware automatisch in Quarantäne" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoQuarantineSignatures}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Verdächtige Dateien automatisch in Quarantäne" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Aus: Bastion fragt dich vorher." />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding AutoQuarantineHeuristics}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Schädliche Prozesse sofort beenden" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding KillMaliciousProcesses}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Ransomware-Notbremse" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Stoppt bei einem Köder-Alarm neue, unsignierte Programme aus Benutzerordnern." />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding RansomwareEmergencyStop}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Signaturen automatisch aktualisieren" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoUpdateSignatures}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Täglicher Schnellscan" />
                                        <Border Margin="8,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Style="{StaticResource Chip}">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="PRO" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="Läuft zur gewählten Stunde, wenn der PC an ist." />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" IsEnabled="{Binding IsPro}">
                                    <ComboBox MinWidth="90" Margin="0,0,12,0" ItemStringFormat="{}{0}:00 Uhr" ItemsSource="{Binding Hours}" SelectedItem="{Binding ScheduledScanHour}" />
                                    <ui:ToggleSwitch IsChecked="{Binding ScheduledScanEnabled}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Exclusions  -->
                <TextBlock Margin="4,24,0,8" Style="{StaticResource SectionHeader}" Text="AUSNAHMEN" />
                <Border Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <TextBlock
                            Margin="16,12"
                            Style="{StaticResource RowDetail}"
                            Text="Keine Ausnahmen. Dateien und Ordner hier werden nie gescannt."
                            Visibility="{Binding Exclusions.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Exclusions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,6">
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MonoDetail}" Text="{Binding}" ToolTip="{Binding}" />
                                        <ui:Button
                                            Padding="4"
                                            HorizontalAlignment="Right"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            ToolTip="Entfernen" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0" Command="{Binding AddExclusionFolderCommand}" Content="Ordner hinzufügen" />
                                <ui:Button Command="{Binding AddExclusionFileCommand}" Content="Datei hinzufügen" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Licensing server  -->
                <TextBlock Margin="4,24,0,8" Style="{StaticResource SectionHeader}" Text="ERWEITERT" />
                <Border Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <StackPanel Margin="16,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Lizenzserver" />
                            <TextBlock Margin="0,2,0,8" Style="{StaticResource RowDetail}" Text="Leer lassen für reine Offline-Lizenzen (Lizenzdatei). API: docs/licensing-api.md" />
                            <ui:TextBox PlaceholderText="https://lizenz.example.com" Text="{Binding LicenseServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Datenordner" />
                                    <TextBlock Style="{StaticResource MonoDetail}" Text="{Binding DataFolder}" />
                                </StackPanel>
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenDataFolderCommand}" Content="Öffnen" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="Version" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Save bar appears when engine settings changed  -->
        <Border
            Margin="0,0,0,20"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Style="{StaticResource GlassPanel}"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
            Visibility="{Binding Dirty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Text="Du hast Einstellungen geändert." />
                <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="Speichern" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
