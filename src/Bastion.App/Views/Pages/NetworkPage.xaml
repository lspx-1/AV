<Page
    x:Class="Bastion.App.Views.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Bastion.App.ViewModels"
    ScrollViewer.CanContentScroll="False"
    Title="Netzwerk">

    <Grid MaxWidth="1040" Margin="40,8,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Netzwerk" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
        </StackPanel>

        <!--  Counters  -->
        <UniformGrid Grid.Row="1" Margin="0,0,0,16" Columns="4">
            <Border Margin="0,0,8,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding RiskyCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="verdächtig" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ProgramCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="Programme online" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ConnectionCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="Verbindungen" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ListeningCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="offene Ports" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  Filter  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Programm oder Adresse suchen"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            <CheckBox
                Grid.Column="1"
                Margin="16,0,0,0"
                Content="Nur Auffälliges"
                IsChecked="{Binding OnlyNotable}" />
        </Grid>

        <!--  Connections: virtualized, only visible rows are drawn  -->
        <Border Grid.Row="3" Padding="4" Style="{StaticResource GlassPanel}">
            <Grid>
                <ListView
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Connections}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selected}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Ellipse Fill="{Binding View.Risk, Converter={StaticResource RiskToBrush}}" Style="{StaticResource Dot}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Process}" />
                                    <TextBlock Style="{StaticResource MonoDetail}" Text="{Binding View.ProcessPath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12.5"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Endpoint}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding SignedText}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{Binding View.Risk, Converter={StaticResource RiskToBrush}}"
                                    Text="{Binding Reasons}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasReasons, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Margin="14,12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Keine Verbindungen für diesen Filter."
                    Visibility="{Binding Connections.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <!--  Actions for the selected connection  -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding HiddenText, TargetNullValue='Wähle eine Verbindung aus, um sie zu beenden oder zu blockieren.'}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Margin="0,0,8,0" Command="{Binding OpenLocationCommand}" Content="Speicherort" Icon="{ui:SymbolIcon Folder24}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding BlockRemoteCommand}" Content="Adresse blockieren" Icon="{ui:SymbolIcon Prohibited24}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding BlockProgramCommand}" Content="Internet sperren" Icon="{ui:SymbolIcon PlugDisconnected24}" />
                <ui:Button Appearance="Danger" Command="{Binding KillCommand}" Content="Prozess beenden" Icon="{ui:SymbolIcon Stop24}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
