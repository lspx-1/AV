<Page
    x:Class="Bastion.App.Views.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Bastion.App.ViewModels"
    Title="Netzwerk">

    <Grid MaxWidth="1040" Margin="40,8,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Netzwerk" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
        </StackPanel>

        <!--  Counters  -->
        <UniformGrid Grid.Row="1" Margin="0,0,0,16" Columns="4">
            <Border Margin="0,0,8,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding RiskyCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="verdächtig" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ProgramCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="Programme online" />
                </StackPanel>
            </Border>
            <Border Margin="4,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ConnectionCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="Verbindungen" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Padding="16,12" Style="{StaticResource GlassPanel}">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding ListeningCount}" />
                    <TextBlock Style="{StaticResource RowDetail}" Text="offene Ports" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  Filter  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Programm oder Adresse suchen"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="1"
                Margin="16,0,0,0"
                Content="Nur Auffälliges"
                IsChecked="{Binding OnlyNotable}" />
        </Grid>

        <!--  Connections  -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Connections}" VirtualizingPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionItemViewModel}">
                            <Border x:Name="Row" Padding="16,10" Style="{StaticResource RowDivider}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Fill="{Binding View.Risk, Converter={StaticResource RiskToBrush}}" Style="{StaticResource Dot}" />
                                    <StackPanel Grid.Column="1" ToolTip="{Binding View.ProcessPath}">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Process}" />
                                        <TextBlock Style="{StaticResource MonoDetail}" Text="{Binding View.ProcessPath}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0">
                                        <TextBlock Style="{StaticResource MonoDetail}" Margin="0" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Endpoint}" />
                                        <TextBlock Style="{StaticResource RowDetail}" Text="{Binding SignedText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding OpenLocationCommand}" Icon="{ui:SymbolIcon Folder24}" ToolTip="Speicherort öffnen" />
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding BlockRemoteCommand}" Icon="{ui:SymbolIcon Prohibited24}" ToolTip="Adresse in der Firewall blockieren" Visibility="{Binding CanBlockRemote, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding BlockProgramCommand}" Icon="{ui:SymbolIcon PlugDisconnected24}" ToolTip="Programm den Internetzugang sperren" Visibility="{Binding CanBlockProgram, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding KillCommand}" Icon="{ui:SymbolIcon Stop24}" ToolTip="Prozess beenden" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{Binding View.Risk, Converter={StaticResource RiskToBrush}}"
                                        Text="{Binding Reasons}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasReasons, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
