<Page
    x:Class="Bastion.App.Views.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Bastion.App.ViewModels"
    ScrollViewer.CanContentScroll="False"
    Title="Scan">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="40,8,40,40">
            <TextBlock Style="{StaticResource PageTitle}" Text="Scan" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Prüfe deinen PC auf Schadsoftware. Der Echtzeitschutz läuft währenddessen weiter." />

            <!--  Scan kinds  -->
            <Grid Visibility="{Binding Running, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="20" Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" Symbol="Flash24" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource RowTitle}" Text="Schnellscan" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="Laufende Programme, Autostart, Downloads, Desktop und AppData. Dauert meist wenige Minuten." TextTrimming="None" TextWrapping="Wrap" />
                        <ui:Button Margin="0,16,0,0" Appearance="Primary" Command="{Binding QuickCommand}" Content="Starten" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="20" Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" Symbol="HardDrive24" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource RowTitle}" Text="Vollständiger Scan" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="Alle Dateien auf allen Laufwerken. Kann je nach Größe eine Stunde oder länger dauern." TextTrimming="None" TextWrapping="Wrap" />
                        <ui:Button Margin="0,16,0,0" Command="{Binding FullCommand}" Content="Starten" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="20" Style="{StaticResource GlassPanel}">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" Symbol="FolderSearch24" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource RowTitle}" Text="Benutzerdefiniert" />
                        <TextBlock Style="{StaticResource RowDetail}" Text="Bestimmte Ordner oder Dateien, zum Beispiel einen USB-Stick." TextTrimming="None" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding CustomPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MonoDetail}" Text="{Binding}" ToolTip="{Binding}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Padding="4"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            ToolTip="Entfernen" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Margin="0,0,8,8" Command="{Binding AddFolderCommand}" Content="Ordner…" />
                            <ui:Button Margin="0,0,8,8" Command="{Binding AddFileCommand}" Content="Dateien…" />
                            <ui:Button Margin="0,0,0,8" Command="{Binding CustomCommand}" Content="Starten" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Progress  -->
            <Border
                Padding="24"
                Style="{StaticResource GlassPanel}"
                Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding KindText}" />
                        <ui:Button HorizontalAlignment="Right" Command="{Binding CancelCommand}" Content="Abbrechen" />
                    </Grid>
                    <ProgressBar Height="4" Margin="0,16,0,0" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Value="{Binding Percent}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource RowDetail}" Text="{Binding CounterText}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MonoDetail}" Text="{Binding CurrentPath}" />
                </StackPanel>
            </Border>

            <ui:InfoBar
                Title="{Binding ResultText}"
                Margin="0,16,0,0"
                IsClosable="True"
                IsOpen="True"
                Severity="Success"
                Visibility="{Binding ResultText, Converter={StaticResource NullToVisibility}}" />

            <!--  Findings  -->
            <StackPanel Margin="0,24,0,0" Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Style="{StaticResource SectionHeader}" Text="FUNDE" />
                <Border Style="{StaticResource GlassPanel}">
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScanFindingViewModel}">
                                <Border x:Name="Row" Padding="16,12" Style="{StaticResource RowDivider}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Style="{StaticResource Dot}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource MonoDetail}" Text="{Binding Path}" ToolTip="{Binding Path}" />
                                            <TextBlock Style="{StaticResource RowDetail}" Text="{Binding Reason}" TextTrimming="None" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource OkBrush}"
                                                Text="{Binding Resolution}"
                                                Visibility="{Binding Resolution, Converter={StaticResource NullToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}">
                                                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding QuarantineCommand}" Content="In Quarantäne" />
                                                <ui:Button Command="{Binding IgnoreCommand}" Content="Ignorieren" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
