<ui:FluentWindow
    x:Class="Bastion.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:Bastion.App.Views.Pages"
    xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Bastion"
    Width="1120"
    Height="780"
    MinWidth="880"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/bastion.ico"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Status"
                    Icon="{ui:SymbolIcon Shield24}"
                    TargetPageType="{x:Type pages:StatusPage}" />
                <ui:NavigationViewItem
                    Content="Scan"
                    Icon="{ui:SymbolIcon Search24}"
                    TargetPageType="{x:Type pages:ScanPage}" />
                <ui:NavigationViewItem
                    Content="Netzwerk"
                    Icon="{ui:SymbolIcon Globe24}"
                    TargetPageType="{x:Type pages:NetworkPage}" />
                <ui:NavigationViewItem
                    Content="Quarantäne"
                    Icon="{ui:SymbolIcon LockClosed24}"
                    TargetPageType="{x:Type pages:QuarantinePage}" />
                <ui:NavigationViewItem
                    Content="Verlauf"
                    Icon="{ui:SymbolIcon History24}"
                    TargetPageType="{x:Type pages:HistoryPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Lizenz"
                    Icon="{ui:SymbolIcon Key24}"
                    TargetPageType="{x:Type pages:LicensePage}" />
                <ui:NavigationViewItem
                    Content="Einstellungen"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <ui:TitleBar
            x:Name="TitleBar"
            Title="Bastion"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/bastion.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <tray:NotifyIcon
            x:Name="TrayIcon"
            Grid.Row="0"
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Assets/bastion.ico"
            LeftClick="TrayIcon_LeftClick"
            MenuOnRightClick="True"
            TooltipText="Bastion">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Click="TrayOpen_Click" Header="Bastion öffnen" />
                    <MenuItem Click="TrayQuickScan_Click" Header="Schnellscan starten" />
                    <Separator />
                    <MenuItem Click="TrayExit_Click" Header="Beenden" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
