<Window
    x:Class="Bastion.App.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="380"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStyle="None">
    <Border
        Margin="12"
        Padding="16,14"
        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Cursor="Hand"
        MouseLeftButtonUp="Body_Click">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.35"
                ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="Accent"
                Width="4"
                Margin="0,0,14,0"
                CornerRadius="2" />
            <StackPanel Grid.Column="1">
                <TextBlock
                    Margin="0,0,0,2"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Bastion" />
                <TextBlock
                    x:Name="TitleText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MessageText"
                    Margin="0,4,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    MaxHeight="54" />
            </StackPanel>
            <ui:Button
                Grid.Column="2"
                Margin="8,-6,-8,0"
                Padding="6"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Click="Close_Click"
                Icon="{ui:SymbolIcon Dismiss24}"
                ToolTip="Schließen" />
        </Grid>
    </Border>
</Window>
