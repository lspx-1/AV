<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows-only APIs are guarded at runtime with OperatingSystem.IsWindows(). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bastion.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Licensing\license-public-key.pem" LogicalName="Bastion.LicensePublicKey" Condition="Exists('Licensing\license-public-key.pem')" />
  </ItemGroup>

</Project>
